        { "sequenceId": 2, "nextTodoId": 201 }
      ]
    },
    {
      "name": "a layer holding no sequences contributes nothing",
      "layers": [
        { "id": 10, "projectId": 1, "title": "Learning", "position": 0 },
        { "id": 20, "projectId": 1, "title": "Design", "position": 1 }
      ],
      "sequences": [
        { "id": 2, "projectId": 1, "layerId": 20, "title": "Design rotor system", "isBlocked": false, "position": 0 }
      ],
      "todos": [
        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Pick a rotor size", "status": "incomplete", "position": 0 }
      ],
      "expected": [{ "sequenceId": 2, "nextTodoId": 201 }]
    },
    {
      "name": "an all-complete project has an empty frontier",
      "layers": [
        { "id": 10, "projectId": 1, "title": "Learning", "position": 0 },
        { "id": 20, "projectId": 1, "title": "Design", "position": 1 }
      ],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 },
        { "id": 2, "projectId": 1, "layerId": 20, "title": "Design rotor system", "isBlocked": false, "position": 0 }
      ],
      "todos": [
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "complete", "position": 0 },
        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Pick a rotor size", "status": "complete", "position": 0 }
      ],
      "expected": []
    },
    {
      "name": "a project with no sequences at all has an empty frontier",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [],
      "todos": [
        { "id": 900, "projectId": 1, "sequenceId": null, "text": "Buy a soldering iron", "status": "incomplete", "position": 0 }
      ],
      "expected": []
    },
    {
      "name": "the drone example surfaces the first unfinished sequence of every layer",
      "layers": [
        { "id": 10, "projectId": 1, "title": "Learning", "position": 0 },
        { "id": 20, "projectId": 1, "title": "Design", "position": 1 },
        { "id": 30, "projectId": 1, "title": "Build", "position": 2 }
      ],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 },
