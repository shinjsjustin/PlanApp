    {
      "name": "an unfinished layer does not hold back the layer below it",
      "layers": [
        { "id": 10, "projectId": 1, "title": "Learning", "position": 0 },
        { "id": 20, "projectId": 1, "title": "Design", "position": 1 }
      ],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn electronics", "isBlocked": false, "position": 0 },
