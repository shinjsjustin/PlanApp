{
  "README": "The ready frontier (spec section 4.3) is derived twice: in the browser by src/client/src/lib/graph.js, and on the server by src/lib/frontier.js for the projects home page. Both test suites read this one table so the two cannot drift apart silently. Client suite: src/client/src/lib/graph.frontier.test.js. Server suite: tests/unit/frontier.test.js. Objects here are in the API's camelCase wire shape, which is what both derivations consume. Each case carries its own layers: the frontier is layer-ordered, a layer contributes at most one entry, and layers never gate one another.",
  "cases": [
    {
      "name": "a layer's only sequence is ready as soon as it is incomplete",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 }
      ],
      "todos": [
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "incomplete", "position": 0 }
      ],
      "expected": [{ "sequenceId": 1, "nextTodoId": 101 }]
    },
    {
      "name": "a ready sequence holding no to-dos has no next to-do",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 }
      ],
      "todos": [],
      "expected": [{ "sequenceId": 1, "nextTodoId": null }]
    },
    {
      "name": "takes the first incomplete to-do by position, not the first one listed",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 }
      ],
      "todos": [
        { "id": 103, "projectId": 1, "sequenceId": 1, "text": "Model the airflow", "status": "incomplete", "position": 2 },
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "complete", "position": 0 },
        { "id": 102, "projectId": 1, "sequenceId": 1, "text": "Sketch the airfoil", "status": "incomplete", "position": 1 }
      ],
      "expected": [{ "sequenceId": 1, "nextTodoId": 102 }]
    },
    {
      "name": "advances to the next sequence in the layer once the leftmost one is complete",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 },
        { "id": 2, "projectId": 1, "layerId": 10, "title": "Learn electronics", "isBlocked": false, "position": 1 }
      ],
      "todos": [
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "complete", "position": 0 },
        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Learn to solder", "status": "incomplete", "position": 0 }
      ],
      "expected": [{ "sequenceId": 2, "nextTodoId": 201 }]
    },
    {
      "name": "surfaces only the first unfinished sequence of a layer, never two from one layer",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": false, "position": 0 },
        { "id": 2, "projectId": 1, "layerId": 10, "title": "Learn electronics", "isBlocked": false, "position": 1 }
      ],
      "todos": [
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "incomplete", "position": 0 },
        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Learn to solder", "status": "incomplete", "position": 0 }
      ],
      "expected": [{ "sequenceId": 1, "nextTodoId": 101 }]
    },
    {
      "name": "contributes nothing from a layer whose first unfinished sequence is blocked, rather than skipping past it",
      "layers": [{ "id": 10, "projectId": 1, "title": "Learning", "position": 0 }],
      "sequences": [
        { "id": 1, "projectId": 1, "layerId": 10, "title": "Learn aerodynamics", "isBlocked": true, "position": 0 },
        { "id": 2, "projectId": 1, "layerId": 10, "title": "Learn electronics", "isBlocked": false, "position": 1 }
      ],
      "todos": [
        { "id": 101, "projectId": 1, "sequenceId": 1, "text": "Read up on lift", "status": "incomplete", "position": 0 },
        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Learn to solder", "status": "incomplete", "position": 0 }
      ],
      "expected": []
    },
