        { "id": 501, "projectId": 1, "sequenceId": 5, "text": "Flash the firmware", "status": "incomplete", "position": 1 },
        { "id": 502, "projectId": 1, "sequenceId": 5, "text": "Bring up the radio", "status": "incomplete", "position": 0 },
        { "id": 900, "projectId": 1, "sequenceId": null, "text": "Buy a soldering iron", "status": "incomplete", "position": 0 }
