        { "id": 201, "projectId": 1, "sequenceId": 2, "text": "Learn to solder", "status": "complete", "position": 0 },
        { "id": 202, "projectId": 1, "sequenceId": 2, "text": "Understand ESCs", "status": "incomplete", "position": 1 },
        { "id": 203, "projectId": 1, "sequenceId": 2, "text": "Read the datasheets", "status": "incomplete", "position": 2 },
