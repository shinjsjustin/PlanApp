# Server
PORT=3001
NODE_ENV=development

# Database — TODO: fill in your MySQL credentials
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Auth — TODO: generate a strong random string (e.g. `openssl rand -hex 32`)
# Required: the server refuses to start without it, rather than signing tokens
# with a default that would be no secret at all.
JWT_SECRET=TODO_replace_with_strong_secret

# API key encryption — 64-char hex = 32 bytes AES-256 key
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=TODO_replace_with_64_char_hex_string

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# URLs
CLIENT_URL=http://localhost:3000

# Google OAuth — TODO: create an OAuth client in Google Cloud Console and fill these in
GOOGLE_CLIENT_ID=TODO_google_client_id
GOOGLE_CLIENT_SECRET=TODO_google_client_secret
GOOGLE_REDIRECT_URI=TODO_google_redirect_uri

# Google Maps (drive times) — optional. Without it places still work and
# travel shows as unavailable. See docs/google-maps-setup.md.
GOOGLE_MAPS_API_KEY=TODO_google_maps_api_key

# Web Push (VAPID) — optional. Without all three, push is disabled (503).
# Generate the key pair with:
#   node -e "console.log(require('./src/lib/push/webPush').generateVapidKeys())"
VAPID_PUBLIC_KEY=TODO_vapid_public_key
VAPID_PRIVATE_KEY=TODO_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Bourne place forwarding — optional. Without both URL and token, place events
# are not forwarded. See docs/bourne-place-forward.md.
BOURNE_PLACE_URL=TODO_bridge_place_route_url
BOURNE_PLACE_TOKEN=TODO_shared_secret
# IANA zone for the time in the forwarded line (default America/Los_Angeles)
BOURNE_PLACE_TIME_ZONE=America/Los_Angeles
